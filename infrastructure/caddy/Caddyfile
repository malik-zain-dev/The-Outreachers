{
    on_demand_tls {
        ask https://api.emareach.com/api/tracking/verify-host
        ask_header X-Tracking-Proxy-Secret {env.TRACKING_PROXY_SHARED_SECRET}
    }
}

:443 {
    tls {
        on_demand
    }

    reverse_proxy https://api.emareach.com {
        # Keep upstream host stable; backend routing is path-based.
        header_up Host api.emareach.com
        header_up X-Forwarded-Proto https
    }
}
